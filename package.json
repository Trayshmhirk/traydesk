{
  "name": "traydesk",
  "version": "1.0.0",
  "private": true,
  "description": "TrayDesk - Multi-framework SaaS Ticket Management System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:next": "pnpm --filter next-app dev",
    "dev:vue": "pnpm --filter vue-app dev",
    "dev:twig": "pnpm --filter twig-app dev",
    "build:next": "pnpm --filter next-app build",
    "build:vue": "pnpm --filter vue-app build",
    "build:twig": "pnpm --filter twig-app build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css,scss}\"",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@prettier/plugin-php": "^0.22.2",
    "@types/node": "^24.10.1",
    "eslint": "^9",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.4"
}
