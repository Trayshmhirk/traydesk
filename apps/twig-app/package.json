{
  "name": "traydesk-twig",
  "version": "1.0.0",
  "description": "TrayDesk Twig/PHP implementation - SaaS Ticket Management System",
  "author": "Osunbajo Micheal (Trayshmhirk)",
  "type": "module",
  "scripts": {
    "dev": "php -S localhost:8000 -t src",
    "build:css": "postcss src/styles/tailwind.css -o src/styles/out.tailwind.css",
    "watch:css": "postcss src/styles/tailwind.css -o src/styles/out.tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.16"
  }
}
